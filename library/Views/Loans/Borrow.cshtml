@model BorrowForm
@{
    ViewData["Title"] = "Borrow a book";
}

<style>
    body {
        background: radial-gradient(circle at top left, #e0f2fe 0%, #f0f9ff 55%, #fff1f2 100%);
        min-height: 100vh;
    }

    /* Center & Frame the Form Area */
    main, .container {
        max-width: 42rem;
        margin: 0 auto;
    }

    /* Heading with Stitch Paw Print */
    h1 {
        color: #1e3a8a;
        font-weight: 800;
        letter-spacing: -0.02em;
        margin-top: 2rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

        h1::before {
            content: "🐾";
            font-size: 1.65rem;
        }

    /* Main Stitch Island Form Card (Loans Coral-Gold Top Accent) */
    form.card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(8px);
        border: 2px solid #7dd3fc;
        border-top: 6px solid #f59e0b;
        border-radius: 22px;
        padding: 1.85rem;
        box-shadow: 0 14px 32px rgba(30, 58, 138, 0.1);
        position: relative;
        overflow: hidden;
    }

        form.card::after {
            content: "🌺";
            position: absolute;
            top: 14px;
            right: 18px;
            font-size: 1.75rem;
            opacity: 0.8;
            transform: rotate(12deg);
            pointer-events: none;
        }

    /* Labels & Inputs */
    .form-label {
        color: #1e40af;
        font-weight: 700;
        font-size: 0.88rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .form-control,
    .form-select {
        border: 2px solid #bae6fd;
        border-radius: 14px;
        padding: 0.65rem 1rem;
        background-color: #f8fafc;
        color: #0f172a;
        font-weight: 500;
        transition: all 0.2s ease;
    }

        .form-control:focus,
        .form-select:focus {
            background-color: #ffffff;
            border-color: #f59e0b;
            box-shadow: 0 0 0 4px rgba(245, 158, 11, 0.22);
        }

    /* Validation Messages */
    .text-danger {
        color: #e11d48 !important;
        font-weight: 600;
        font-size: 0.85rem;
        margin-top: 0.25rem;
        display: block;
    }

    /* Sunset Coral-Gold Borrow Button (Matches Loans Theme) */
    .btn-primary {
        background: linear-gradient(90deg, #e11d48 0%, #fb7185 50%, #f59e0b 100%) !important;
        border: none !important;
        border-radius: 50rem !important;
        padding: 0.6rem 1.85rem !important;
        font-weight: 700;
        letter-spacing: 0.02em;
        box-shadow: 0 6px 16px rgba(225, 29, 72, 0.3);
        transition: all 0.2s ease;
    }

        .btn-primary:hover {
            opacity: 0.94;
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(225, 29, 72, 0.4);
        }

    /* Lilo Hibiscus Coral Cancel Link */
    .btn-link {
        color: #e11d48 !important;
        font-weight: 600;
        text-decoration: none !important;
        padding: 0.6rem 1.1rem;
        border-radius: 50rem;
        transition: background-color 0.2s ease;
    }

        .btn-link:hover {
            background-color: #ffe4e6;
            color: #be123c !important;
        }
</style>

<h1 class="mb-3">Borrow a book</h1>
<form asp-action="Borrow" method="post" class="card card-body" style="max-width:36rem">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
    <div class="mb-3">
        <label asp-for="MemberId" class="form-label">Member</label>
        <select asp-for="MemberId" asp-items="ViewBag.Members" class="form-select">
            <option value="">(choose a member)</option>
        </select>
        <span asp-validation-for="MemberId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="BookId" class="form-label">Book</label>
        <select asp-for="BookId" asp-items="ViewBag.Books" class="form-select">
            <option value="">(choose a book)</option>
        </select>
        <span asp-validation-for="BookId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="DaysAllowed" class="form-label">Days allowed</label>
        <input asp-for="DaysAllowed" class="form-control" />
        <span asp-validation-for="DaysAllowed" class="text-danger"></span>
    </div>
    <div>
        <button type="submit" class="btn btn-primary">Borrow</button>
        <a asp-action="Index" class="btn btn-link">Cancel</a>
    </div>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}