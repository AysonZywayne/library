@{
    ViewData["Title"] = "Library Dashboard";
}

<!-- Custom Styles for the Cool Layout -->
<style>
    .cool-hero {
        background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
        color: white;
        border-radius: 1rem;
        box-shadow: 0 10px 30px rgba(42, 82, 152, 0.2);
    }

    .hover-card {
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
        border: none;
        border-radius: 1rem;
    }

        .hover-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.15) !important;
        }

    .cool-btn-blue {
        background: linear-gradient(90deg, #00c6ff 0%, #0072ff 100%);
        color: white;
        border: none;
        border-radius: 2rem;
        font-weight: 600;
        transition: opacity 0.2s;
    }

    .cool-btn-green {
        background: linear-gradient(90deg, #11998e 0%, #38ef7d 100%);
        color: white;
        border: none;
        border-radius: 2rem;
        font-weight: 600;
        transition: opacity 0.2s;
    }

        .cool-btn-blue:hover, .cool-btn-green:hover {
            opacity: 0.9;
            color: white;
        }
</style>

<div class="container py-5">
    <!-- Modern Vibrant Hero Unit -->
    <div class="p-5 mb-5 cool-hero text-center text-md-start">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h1 class="display-4 fw-black mb-3 text-white">Library</h1>
                <p class="fs-5 opacity-75 mb-0">
                    Welcome!! Instantly deploy new catalog adjustments, sync live members.
                </p>
            </div>
            <div class="col-md-4 text-center d-none d-md-block text-white opacity-25">
                <span style="font-size: 6rem;">⚡</span>
            </div>
        </div>
    </div>

    <!-- Interactive Grid Systems -->
    <div class="row g-4 justify-content-center">
        <!-- Interactive Books Management Card -->
        <div class="col-md-5">
            <div class="card h-100 shadow-sm hover-card bg-white border-start border-primary border-5">
                <div class="card-body d-flex flex-column p-4">
                    <div class="d-flex align-items-center mb-3">
                        <span class="fs-2 me-3">📖</span>
                        <h3 class="card-title m-0 fw-bold text-dark">Book Collection</h3>
                    </div>
                    <p class="card-text text-muted flex-grow-1">
                        Run deep audits on book inventories, categorize genres, and balance listing value metrics.
                    </p>
                    <a asp-controller="Books" asp-action="Index" class="btn cool-btn-blue py-2 mt-4 shadow-sm">
                        Open Books Library &rarr;
                    </a>
                </div>
            </div>
        </div>

        <!-- Interactive Members Management Card -->
        <div class="col-md-5">
            <div class="card h-100 shadow-sm hover-card bg-white border-start border-success border-5">
                <div class="card-body d-flex flex-column p-4">
                    <div class="d-flex align-items-center mb-3">
                        <span class="fs-2 me-3">⚡</span>
                        <h3 class="card-title m-0 fw-bold text-dark">Members</h3>
                    </div>
                    <p class="card-text text-muted flex-grow-1">
                        Provision new accounts and secure credentials. Real time auditing of profile classes, classification logs, active rental permissions, and verification status fields.
                    </p>
                    <a asp-controller="Member" asp-action="Index" class="btn cool-btn-green py-2 mt-4 shadow-sm">
                        Open Members &rarr;
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
