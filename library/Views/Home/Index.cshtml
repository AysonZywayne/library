@{
    ViewData["Title"] = "Library Dashboard";
}

<style>
    /* Stitch / Experiment 626 Tropical Ocean Background */
    body {
        background: radial-gradient(circle at top left, #e0f2fe 0%, #f0f9ff 55%, #fff1f2 100%);
        min-height: 100vh;
    }

    /* Experiment 626 Cosmic Blue Hero Banner */
    .cool-hero {
        background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 55%, #0284c7 100%);
        color: white;
        border-radius: 1.5rem;
        border: 2px solid #7dd3fc;
        box-shadow: 0 14px 35px rgba(2, 132, 199, 0.25);
        position: relative;
        overflow: hidden;
    }

        /* Subtle Tropical Hibiscus Watermark in Hero */
        .cool-hero::after {
            content: "🌺";
            position: absolute;
            bottom: -15px;
            right: 25px;
            font-size: 5rem;
            opacity: 0.18;
            transform: rotate(-15deg);
            pointer-events: none;
        }

    /* Stitch Island Cards */
    .hover-card {
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
        border: 2px solid #e0f2fe;
        border-radius: 1.35rem;
        background: rgba(255, 255, 255, 0.95) !important;
        backdrop-filter: blur(6px);
    }

        .hover-card:hover {
            transform: translateY(-8px);
            border-color: #7dd3fc;
            box-shadow: 0 18px 35px rgba(30, 58, 138, 0.14) !important;
        }

        /* Matching Left Accent Borders */
        .hover-card.border-primary {
            border-left: 6px solid #2563eb !important;
        }

        .hover-card.border-success {
            border-left: 6px solid #0d9488 !important;
        }

        .hover-card.border-warning {
            border-left: 6px solid #f43f5e !important;
        }

    /* Stitch Cosmic Blue Pill Button */
    .cool-btn-blue {
        background: linear-gradient(90deg, #1d4ed8 0%, #0ea5e9 100%);
        color: white;
        border: none;
        border-radius: 2rem;
        font-weight: 700;
        letter-spacing: 0.02em;
        box-shadow: 0 6px 15px rgba(14, 165, 233, 0.3);
        transition: all 0.2s ease;
    }

    /* Hawaiian Tropical Teal Pill Button */
    .cool-btn-green {
        background: linear-gradient(90deg, #0d9488 0%, #2dd4bf 100%);
        color: white;
        border: none;
        border-radius: 2rem;
        font-weight: 700;
        letter-spacing: 0.02em;
        box-shadow: 0 6px 15px rgba(13, 148, 136, 0.3);
        transition: all 0.2s ease;
    }

    /* Lilo Hibiscus Coral / Sunset Gold Pill Button */
    .cool-btn-warning {
        background: linear-gradient(90deg, #e11d48 0%, #fb7185 50%, #f59e0b 100%);
        color: white;
        border: none;
        border-radius: 2rem;
        font-weight: 700;
        letter-spacing: 0.02em;
        box-shadow: 0 6px 15px rgba(225, 29, 72, 0.28);
        transition: all 0.2s ease;
    }

    .hover-card.border-warning {
        border: 5px solid #f59e0b !important;
    }

        .cool-btn-blue:hover,
        .cool-btn-green:hover,
        .cool-btn-warning:hover {
            opacity: 0.94;
            color: white;
            transform: translateY(-2px);
        }
</style>

<div class="container py-5">
    <!-- Modern Vibrant Hero Unit -->
    <div class="p-5 mb-5 cool-hero text-center text-md-start">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h1 class="display-4 fw-black mb-3 text-white">Library</h1>
                <p class="fs-5 opacity-75 mb-0">
                    Welcome!! Instantly deploy new catalog adjustments, sync live members.
                </p>
            </div>
            <div class="col-md-4 text-center d-none d-md-block text-white opacity-25">
                <span style="font-size: 6rem;">⚡</span>
            </div>
        </div>
    </div>

    <!-- Interactive Grid Systems -->
    <div class="row g-4 justify-content-center">
        <!-- Interactive Books Management Card -->
        <div class="col-md-5">
            <div class="card h-100 shadow-sm hover-card bg-white border-start border-primary border-5">
                <div class="card-body d-flex flex-column p-4">
                    <div class="d-flex align-items-center mb-3">
                        <span class="fs-2 me-3">📖</span>
                        <h3 class="card-title m-0 fw-bold text-dark">Book Collection</h3>
                    </div>
                    <p class="card-text text-muted flex-grow-1">
                        Run deep audits on book inventories, categorize genres, and balance listing value metrics.
                    </p>
                    <a asp-controller="Books" asp-action="Index" class="btn cool-btn-blue py-2 mt-4 shadow-sm">Open Books Library &rarr;</a>
                </div>
            </div>
        </div>

        <!-- Interactive Members Management Card -->
        <div class="col-md-5">
            <div class="card h-100 shadow-sm hover-card bg-white border-start border-success border-5">
                <div class="card-body d-flex flex-column p-4">
                    <div class="d-flex align-items-center mb-3">
                        <span class="fs-2 me-3">👥</span>
                        <h3 class="card-title m-0 fw-bold text-dark">Members</h3>
                    </div>
                    <p class="card-text text-muted flex-grow-1">
                        Provision new accounts and secure credentials. Real time auditing of profile classes, classification logs, active rental permissions, and verification status fields.
                    </p>
                    <a asp-controller="Member" asp-action="Index" class="btn cool-btn-green py-2 mt-4 shadow-sm">Open Members &rarr;</a>
                </div>
            </div>
        </div>

        <!-- Interactive Loans Management Card -->
        <div class="col-md-5">
            <div class="card h-100 shadow-sm hover-card bg-white border border-warning border-3">
                <div class="card-body d-flex flex-column p-4">
                    <div class="d-flex align-items-center mb-3">
                        <span class="fs-2 me-3">⚡</span>
                        <h3 class="card-title m-0 fw-bold text-dark">Loans</h3>
                    </div>
                    <p class="card-text text-muted flex-grow-1">
                        Manage library circulation and book checkouts. Monitor active member loans, upcoming due dates, overdue alerts, and completed returns in one place.
                    </p>
                    <a asp-controller="Loans" asp-action="Index" class="btn cool-btn-warning py-2 mt-4 shadow-sm">Open Loans &rarr;</a>
                </div>
            </div>
        </div>
    </div>
</div>
