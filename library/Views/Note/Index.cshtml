@model List<Note>
@{
    ViewData["Title"] = "Notes";
}

<div class="d-flex gap-2 mb-4">
    <a asp-controller="Home" asp-action="Index" class="btn btn-sm btn-light border rounded-pill px-3 d-inline-flex align-items-center gap-1">
        <span></span> Back to Home
    </a>
</div>

<div class="d-flex justify-content-between align-items-center my-4">
    <div>
        <h1 class="fw-bold mb-1" style="font-size: 2.5rem; color: #1a1a1a;">Notes</h1>
        <span class="badge rounded-pill bg-success px-2 py-1" style="font-size: 0.9rem; background-color: #198754 !important;">
            <span class="fw-bold">@Model.Count</span> notes in the collection
        </span>
    </div>
    <a asp-action="Create" class="btn text-white px-4 py-2 fw-semibold rounded-pill" style="background-color: #0f8b5a;">
        <span class="me-1"></span> Add a Note
    </a>
</div>

<div class="table-responsive mt-4">
    <table class="table align-middle" style="--bs-table-bg: transparent; border-collapse: separate; border-spacing: 0;">
        <thead>
            <tr class="text-secondary" style="font-size: 0.85rem; letter-spacing: 0.5px; border-bottom: 2px solid #f0f0f0;">
                <th class="text-end fw-bold pb-3" style="width: 5rem;"># ID</th>
                <th class="fw-bold pb-3" style="padding-left: 1.5rem;">Title</th>
                <th class="fw-bold pb-3">Content Summary</th>
                <th class="fw-bold pb-3">Created</th>
                <th class="text-center fw-bold pb-3" style="width: 12rem;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var note in Model)
            {
                <tr style="border-bottom: 1px solid #eaeaea;">
                    <td class="text-end text-muted fw-semibold small py-3">#@note.NoteId</td>
                    <td class="fw-bold py-3" style="padding-left: 1.5rem; color: #212529;">@note.Title</td>
                    <td class="text-muted py-3">
                        <span class="text-truncate d-inline-block" style="max-width: 300px; vertical-align: middle;">
                            @(note.Body ?? "—")
                        </span>
                    </td>
                    <td class="py-3">
                        <span class="badge rounded-pill px-3 py-2 text-muted fw-medium" style="background-color: #f8f9fa; border: 1px solid #e9ecef; font-size: 0.85rem;">
                            @(note.CreatedOn?.ToString("g") ?? "—")
                        </span>
                    </td>
                    <td class="text-center py-3">
                        <div class="d-inline-flex gap-2">
                            <a asp-action="Edit" asp-route-id="@note.NoteId"class="btn btn-sm btn-outline-secondary rounded-pill px-3 fw-medium transition-all">Edit</a>
                            <a asp-action="Delete" asp-route-id="@note.NoteId"class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-medium transition-all">Delete</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
